SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*

# Keep postgresql for the existing project database, or set DB_ENGINE=sqlite
# for a quick local-only development database.
DB_ENGINE=postgresql
DB_NAME=mobileapp
DB_USER=postgres
DB_PASSWORD=adminspongy
DB_HOST=localhost
DB_PORT=5432

# SQLite option:
# DB_ENGINE=sqlite
# SQLITE_NAME=db.sqlite3

# Azure AI Document Intelligence (modele prebuilt-read) - lecture des etiquettes.
# Laisser vide tant que le compte Azure de la societe n'est pas configure.
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=

# Laboratoire masque par defaut (role, comptes, notifications). True pour le reactiver,
# avec `flutter run --dart-define=LABO_ACTIF=true` cote application.
LABO_ACTIF=False
